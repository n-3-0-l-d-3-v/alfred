{
  "manifest_version": 3,
  "name": "LeetLearn",
  "version": "0.1.0",
  "description": "Socratic hints, real code review, and streaks for LeetCode. Solve it yourself first \u2014 then get everything.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LeetLearn"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "lib/ext.js",
        "content/leetcode-adapter.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
