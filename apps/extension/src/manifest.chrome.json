{
  "manifest_version": 3,
  "name": "LeetLearn",
  "version": "0.1.0",
  "description": "Socratic hints, real code review, and streaks for LeetCode. Solve it yourself first \u2014 then get everything.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LeetLearn",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "lib/ext.js",
        "content/leetcode-adapter.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-bridge.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
