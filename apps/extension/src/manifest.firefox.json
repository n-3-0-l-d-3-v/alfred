{
  "manifest_version": 3,
  "name": "LeetLearn",
  "version": "0.1.0",
  "description": "Socratic hints, real code review, and streaks for LeetCode. Solve it yourself first \u2014 then get everything.",
  "browser_specific_settings": {
    "gecko": {
      "id": "leetlearn@neilthomasmathew.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "scripts": [
      "lib/ext.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open LeetLearn",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "panel/panel.html",
    "default_title": "LeetLearn",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "lib/ext.js",
        "content/platforms.js",
        "content/leetcode-adapter.js",
        "content/platform-generic.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-bridge.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
